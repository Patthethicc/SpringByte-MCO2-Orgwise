# Copy to .env (never commit .env) and change the secrets before a real deployment:
#   cp .env.example .env
# docker compose reads .env automatically.

# ---- MySQL --------------------------------------------------------------------------
MYSQL_ROOT_PASSWORD=change-me-root
# Host port for MySQL Workbench (container port is always 3306)
MYSQL_HOST_PORT=3307

# One user per service, each limited to its own schema (see db/init/02-create-users.sh)
IDENTITY_DB_USER=identity_user
IDENTITY_DB_PASSWORD=change-me-identity
EVENT_DB_USER=event_user
EVENT_DB_PASSWORD=change-me-event
EXPENSE_DB_USER=expense_user
EXPENSE_DB_PASSWORD=change-me-expense
TREASURY_DB_USER=treasury_user
TREASURY_DB_PASSWORD=change-me-treasury
REPORTING_DB_USER=reporting_user
REPORTING_DB_PASSWORD=change-me-reporting

# ---- Security -----------------------------------------------------------------------
# Base64-encoded HS256 key, at least 32 bytes before encoding. Generate one with:
#   openssl rand -base64 48
# Every service must use the same value (identity signs, the others verify).
JWT_SECRET=b3Jnd2lzZS1kZXYtb25seS1zZWNyZXQtY2hhbmdlLW1lLTMyYnl0ZXMhIQ==

# ---- Treasury -----------------------------------------------------------------------
# Opening balance used only the first time the treasury account is created
TREASURY_INITIAL_BALANCE=100000.00

# ---- Host ports ---------------------------------------------------------------------
GATEWAY_HOST_PORT=8080
EUREKA_HOST_PORT=8761
FRONTEND_HOST_PORT=3000
